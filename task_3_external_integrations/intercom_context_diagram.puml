/*
Роли:
- Посетитель
- Владелец

Контексты взаимодействия
- Владелец добавляет фотографию посетителя в список разрешённых (фотографию делает сам видеодомофон)
- Владелец просто открывает дверь по видеозвонку
- Владелец просматривает фотографии всех, кто звонил в домофон или пытался пройти в его квартиру
- Посетитель инициирует видеозвонок по домофону
- Посетитель нажимает кнопку "пройти" и проходит через распознавание по фотографии, если он добавлен в список разрашённых
*/

@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Контекстная диаграмма системы умного видеодомофона

Person(visitor, "Посетитель", "Человек, который хочет попасть в здание/квартиру")
Person(owner, "Владелец", "Владелец квартиры, который управляет доступом")

System_Ext(intercom, "Интеллектуальный видеодомофон", "Система видеодомофона с функциями распознавания лиц, видеозвонков и управления доступом")

System(mobile_app, "Мобильное приложение", "Приложение для владельца для управления домофоном")
'System_Ext(face_recognition, "Сервис распознавания лиц", "Внешний сервис для обработки и сравнения изображений лиц")
System_Ext(cloud_storage, "Облачное хранилище", "Хранение фотографий и видеозаписей")
'System_Ext(notification_service, "Сервис уведомлений", "Отправка push-уведомлений владельцу")

Rel(visitor, intercom, "Инициирует видеозвонок", "Нажимает кнопку вызова")
Rel(visitor, intercom, "Запрашивает проход", "Нажимает кнопку 'пройти'")

Rel(owner, mobile_app, "Управляет доступом", "Добавляет разрешенных лиц, открывает дверь")
Rel(owner, mobile_app, "Просматривает историю", "Смотрит фотографии посетителей")

Rel(intercom, owner, "Отправляет видеозвонок", "При вызове посетителя")
'Rel(intercom, face_recognition, "Отправляет фото для распознавания", "API запрос")
Rel(intercom, cloud_storage, "Сохраняет фотографии/видео", "Загрузка медиафайлов")
Rel(intercom, mobile_app, "Отправляет уведомления", "О посетителях и событиях")

Rel(mobile_app, intercom, "Управляющие команды", "Открытие двери, добавление лиц")
Rel(mobile_app, cloud_storage, "Получает медиафайлы", "Загрузка фото/видео")

@enduml


